{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/style-signals",
      "schedule": "0 6 */2 * *"
    },
    {
      "path": "/api/cron/brand-health",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/quality-feedback",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/learning-analyst",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/vocab-review",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/corpus-fill",
      "schedule": "0 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "from.enuid.com" }],
      "destination": "https://discern.enuid.com/:path*",
      "permanent": true
    }
  ]
}
